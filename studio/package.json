{
  "name": "crew-platform",
  "version": "1.0.0",
  "main": "electron-main.cjs",
  "private": true,
  "type": "module",
  "description": "C.R.E.W. Software — guided creation with a Python workflow engine",
  "scripts": {
    "dev": "vite",
    "start": "bun run server/index.ts",
    "build": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "test": "bun test test/core.bun.test.ts",
    "test:tour": "node node_modules/vitest/vitest.mjs run test/tour-overlap.test.ts",
    "test:approval": "node node_modules/vitest/vitest.mjs run test/approval-enforcement.test.ts",
    "test:acceptance": "CREW_ACCEPTANCE=1 node node_modules/vitest/vitest.mjs run test/acceptance --no-file-parallelism --hookTimeout=180000 --testTimeout=600000 --reporter=default --reporter=json --outputFile=test-results/acceptance.json",
    "test:acceptance-full": "CREW_ACCEPTANCE=1 CREW_ACCEPTANCE_FULL=1 node node_modules/vitest/vitest.mjs run test/acceptance --no-file-parallelism --hookTimeout=180000 --testTimeout=600000 --reporter=default --reporter=json --outputFile=test-results/acceptance.json",
    "postinstall": "vite build",
    "electron": "electron .",
    "electron:build": "electron-builder",
    "electron:start": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder --win --x64",
    "electron:publish": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/inter": "^5",
    "@fontsource/play": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@vitejs/plugin-vue": "^6",
    "@vitest/browser": "^2",
    "playwright": "^1.50",
    "typescript": "^5.7.2",
    "vite": "^7",
    "vitest": "^2",
    "vue-tsc": "^3",
    "electron": "^29.3.0",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1"
  }
}
